<Window x:Class="VmixSubtitleController.StudioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="490" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource StudioBase}"
        Foreground="{StaticResource StudioText}" FontFamily="Segoe UI" FontSize="13">
    <Border Margin="14" Padding="18" CornerRadius="12" Background="{StaticResource StudioPanel}"
            BorderBrush="{StaticResource StudioLine}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="19" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="255" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="{StaticResource StudioMuted}" LineHeight="20" />
            </ScrollViewer>
            <StackPanel x:Name="Actions" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right" />
        </StackPanel>
    </Border>
</Window>
