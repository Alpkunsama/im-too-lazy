<TextBlock Text="SRT Dosyası" Foreground="{DynamicResource PaletteA2A6AC}" Margin="0,16,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBox x:Name="DetailFile" IsReadOnly="True" Height="38"/><Button Grid.Column="1" Content="…" Click="DetailBrowse_Click" Padding="5" Margin="6,0,0,0"/></Grid>
<TextBlock Text="Altyazı satırı" Foreground="{DynamicResource PaletteA2A6AC}" Margin="0,14,0,6"/><ComboBox x:Name="DetailCueBox" SelectionChanged="DetailCue_Changed"/>
<TextBlock Text="Orijinal Metin" Margin="0,16,0,7"/><TextBox x:Name="DetailOriginal" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="94" VerticalScrollBarVisibility="Auto"/>
<TextBlock x:Name="DetailTranslationLabel" Text="Çevrilen Metin" Margin="0,16,0,7"/><TextBox x:Name="DetailTranslation" TextWrapping="Wrap" AcceptsReturn="True" Height="94" VerticalScrollBarVisibility="Auto" TextChanged="DetailTranslation_Changed"/>
<TextBlock x:Name="DetailDraftStatus" Foreground="{DynamicResource PaletteA2A6AC}" TextWrapping="Wrap" Margin="0,8,0,12"/>
<UniformGrid Columns="3"><Button Content="▶ Önizle" Click="DetailPreview_Click" Padding="5,10" Margin="0,0,6,0" FontSize="11"/><Button Content="SRT Kaydet" Click="DetailSave_Click" Padding="5,10" Margin="0,0,6,0" FontSize="11"/><Button Content="Slota Uygula" Click="DetailApply_Click" Padding="5,10" Background="{DynamicResource PaletteD0D2D6}" Foreground="{DynamicResource Palette202225}" FontSize="11"/></UniformGrid>
</StackPanel></ScrollViewer></Border>
<TextBlock x:Name="ClockText" Grid.Row="2" HorizontalAlignment="Right" Foreground="{DynamicResource PaletteA2A6AC}" Margin="0,14,0,0"/></Grid>
</Grid>
<wv:WebView2 x:Name="WebSurface"/>
<Border x:Name="WebFailure" Visibility="Collapsed" Background="#17191D" Padding="40"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="700"><TextBlock Text="Arayüz açılamadı" FontSize="26" Margin="0,0,0,20"/><TextBlock x:Name="WebFailureText" TextWrapping="Wrap"/><Button Content="Tekrar dene" Click="RetryWeb_Click" Margin="0,24,0,0"/></StackPanel></Border>
</Grid></Window>
