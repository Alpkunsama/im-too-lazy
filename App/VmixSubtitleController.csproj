<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>im too lazy</AssemblyName>
    <RootNamespace>VmixSubtitleController</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(UpdateFeedUrl)' != ''">
    <AssemblyMetadata Include="UpdateFeedUrl" Value="$(UpdateFeedUrl)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Titles/im too lazy - Subtitle Auto Background.xaml" Link="Titles/im too lazy - Subtitle Auto Background.xaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="app.ico" />
    <Resource Include="WebUI/dist/index.html;WebUI/dist/app.js;WebUI/dist/app.css" />
    <None Remove="WebUI/node_modules/**/*" />
    <Compile Remove="WebUI/**/*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="Installer/**/*.cs" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Reference Include="libomtnet">
      <HintPath>ThirdParty\OMT\Winx64\libomtnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Remove="ThirdParty\OMT\Winx64\libvmx.dll" />
    <Content Include="ThirdParty\OMT\Winx64\libvmx.dll" Link="libvmx.dll" TargetPath="libvmx.dll" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <None Include="ThirdParty\OMT\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
