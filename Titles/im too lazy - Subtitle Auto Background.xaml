<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="1920" Height="1080">
 <Grid>
  <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="160,0,160,86"
    MaxWidth="1600" Padding="28,6" CornerRadius="10" Background="#B3000000">
   <Border.Style>
    <Style TargetType="Border">
     <Style.Triggers>
      <DataTrigger Binding="{Binding Text, ElementName=Message}" Value=""><Setter Property="Opacity" Value="0" /></DataTrigger>
      <DataTrigger Binding="{Binding Text, ElementName=Message}" Value="{x:Null}"><Setter Property="Opacity" Value="0" /></DataTrigger>
      <DataTrigger Binding="{Binding Text, ElementName=Message}" Value="&#x20;"><Setter Property="Opacity" Value="0" /></DataTrigger>
     </Style.Triggers>
    </Style>
   </Border.Style>
   <TextBlock Name="Message" Text="" FontFamily="Arial" FontSize="50"
    Foreground="White" TextAlignment="Center" TextWrapping="Wrap" />
  </Border>
 </Grid>
</UserControl>